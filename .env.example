# IRMS Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application environment: development | production
IRMS_ENV=development

# Session secret key (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
IRMS_SESSION_SECRET=

# Session max age in seconds (default: 28800 = 8 hours)
IRMS_SESSION_MAX_AGE=28800

# Require explicit session secret (default: true in production)
IRMS_REQUIRE_SESSION_SECRET=true

# Data directory path (default: ./data)
IRMS_DATA_DIR=./data

# Seed demo data on startup (default: true in development, false in production)
# WARNING: Inserts users with well-known passwords. Never enable in production.
IRMS_SEED_DEMO_DATA=false

# Tray client shared token for attendance alert polling.
# REQUIRED by default in production; optional in development LAN deployments.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the same value in the tray client's
# %APPDATA%\IRMS-Notice\config.json as "tray_api_token".
IRMS_TRAY_API_TOKEN=
IRMS_REQUIRE_TRAY_API_TOKEN=true

# === External Access (Cloudflare Tunnel) ===
# Switch to "production" before exposing the app via cloudflared.
# This enables HSTS, Secure cookies, and strict same-site.
# IRMS_ENV=production

# Public hostname behind cloudflared. Informational only (used in docs/logs);
# IRMS does not read this at runtime in the current release.
# IRMS_PUBLIC_HOST=irms.example.com

# === Backups & watchdog (serve.py) ===
# serve.py backs the DB up daily and immediately before every auto-update.
# It verifies each backup and quarantines corrupt ones as *.corrupt.

# SECOND COPY OF EVERY BACKUP. Leave this empty and your only backups sit on the
# same disk as the live database - one disk failure loses both. Point it at a
# DIFFERENT MACHINE (company NAS / file server share) if you can; another drive
# in the same PC survives a disk failure but not fire, theft, or ransomware.
# Example: IRMS_BACKUP_MIRROR=\nas01\irms-backup
IRMS_BACKUP_MIRROR=

# Backup retention in days (the 5 most recent are always kept regardless).
IRMS_BACKUP_KEEP_DAYS=30

# Server port, update-check interval in seconds, and auto-update on/off.
IRMS_PORT=9000
IRMS_AUTO_INTERVAL=600
IRMS_AUTO_UPDATE=1

# Ceiling for the dependency install step, in seconds. Without a limit a
# hung package index freezes the watchdog: the server keeps serving, so the
# screens look fine, while backups and updates stop happening for good.
IRMS_PIP_TIMEOUT=900

# === Tunnel exposure ===
# cloudflared publishes the WHOLE app, and the shop-floor screens are
# deliberately login-free - that is correct on the LAN and wide open on the
# internet. With this on, requests carrying Cloudflare's edge headers must
# have a manager session; LAN requests are untouched. Set to 0 only if you
# have put Cloudflare Access (or equivalent) in front of the tunnel.
IRMS_TUNNEL_REQUIRE_LOGIN=1

# Days a canceled blend record is kept before automatic physical deletion.
# Cancel exists to undo mistakes, and mistakes surface within a day or two -
# no need to keep them forever (operator decision 2026-07-29). A full snapshot
# goes to the audit log first, and the daily purge runs only after a successful
# backup, so the record is always in that day's backup. 0 disables the purge.
IRMS_CANCELED_RETENTION_DAYS=3
